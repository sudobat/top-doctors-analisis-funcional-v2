# Copiar este archivo a `.env` en la raíz del repo (`.env` está en .gitignore).
# No subas credenciales al repositorio ni las pegues en tickets públicos.

PLAYWRIGHT_BASE_URL=https://www.topdoctors.es
PLAYWRIGHT_LOGIN_PATH=/login/

# Opcional: si prefieres URL absoluta de login
# PLAYWRIGHT_LOGIN_URL=https://www.topdoctors.es/login/

# Pantalla objetivo del spec (hasta que exista la vista unificada puede seguir siendo office).
PLAYWRIGHT_UNIFIED_CONFIG_PATH=/backoffice-provider/office/

# Legacy / referencia hasta migración: /backoffice-provider/profile/services

PLAYWRIGHT_DOCTOR_EMAIL=
PLAYWRIGHT_DOCTOR_PASSWORD=

# Omitir login automático aunque existan credenciales (sesión manual / PLAYWRIGHT_STORAGE_STATE)
# PLAYWRIGHT_SKIP_GLOBAL_SETUP=1

# Sesión exportada manualmente (tiene prioridad sobre la generada por global-setup)
# PLAYWRIGHT_STORAGE_STATE=./mi-sesion.json

# Solo para E2E-UCFG-029 (intercept POST guardado)
# PLAYWRIGHT_SAVE_URL_GLOB=
